@layer theme, base, components, utilities;

@import 'tailwindcss';
@import './m3/fig-tokens.css';
@import './m3/typography.css';
@import './m3/m3.pcss';
@import './partials/vars.pcss';
@import './partials/hack.pcss' layer(base);
@import './vendor/nprogress.pcss' layer(base);
@import './partials/skeleton.pcss' layer(base);
@import './partials/tooltip.pcss' layer(base);
@import './partials/context-menu.pcss' layer(base);
@import './partials/shared.pcss' layer(base);
@import './partials/scroll-mask.pcss';

@config "../../tailwind.config.js";

@custom-variant no-hover (@media (hover: none));

/* Borders default to the scheme's outline-variant. */
@layer base {
  *,
  ::after,
  ::before,
  ::backdrop,
  ::file-selector-button {
    border-color: var(--schemes-outline-variant);
  }
}

@utility playable-list-item {
  @apply border-b border-(--schemes-outline-variant) max-w-full! h-[64px] flex
    items-center transition-[background-color] ease-in-out duration-200
    focus:ring-inset focus:ring-1 focus:ring-(--schemes-primary)!
    focus-within:ring-inset focus-within:ring-1 focus-within:ring-(--schemes-primary)!
    hover:bg-(--schemes-surface-container-high);

  &.selected {
    @apply bg-(--schemes-surface-container-highest);
  }
}
