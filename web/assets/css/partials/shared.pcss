h1,
h2,
h3,
h4,
h5,
h6,
blockquote {
  @apply text-balance;
}

*::marker {
  @apply hidden!;
}

:root {
  color-scheme: light;
}

:root[data-mode$='-dt'],
:root[data-theme='dark'] {
  color-scheme: dark;
}

input,
textarea {
  @apply placeholder:text-(--schemes-on-surface-variant);
}

body,
html {
  font-family: var(--font-family);
  font-size: 14px;

  @apply h-screen text-(--schemes-on-surface) font-normal leading-6 overflow-hidden;
}

body {
  background-color: var(--schemes-surface);
}

input,
select,
button,
textarea,
.btn {
  font-family: var(--font-family);

  @apply appearance-none border-0 outline-0 text-base font-normal;

  &:required,
  &:invalid {
    @apply shadow-none;
  }

  &::-moz-focus-inner {
    @apply border-0!;
  }
}

:where(a) {
  @apply no-underline cursor-pointer focus:text-(--schemes-primary);

  color: var(--schemes-on-surface);

  @media (hover: hover) {
    &:hover {
      color: var(--schemes-primary);
    }
  }
}

button,
[role='button'] {
  @apply touch-manipulation select-none cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--schemes-primary);
}

* {
  @apply focus-visible:ring-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--schemes-primary);

  &::selection {
    @apply bg-(--schemes-primary) text-(--schemes-on-primary);
  }
}

/*
 * The albums' and artists' tables: a heading row and the rows under it share
 * their columns. The cover lines up with the screen's content; the name's
 * heading with the names.
 */
.list-table-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 8px 0 var(--screen-pad-x, 24px);

  > span {
    display: flex;
    align-items: center;
    min-width: 0;
    overflow: hidden;
  }

  > .name {
    flex: 1 1 0;
    gap: 16px;
  }

  > .artist {
    flex: 0 0 12rem;
  }

  > .time,
  > .year {
    flex: 0 0 5rem;
  }

  > .rating {
    flex: 0 0 7rem;
  }

  > .favorite,
  > .extra {
    flex: 0 0 3rem;
    justify-content: center;
  }

  > .cover-aligned {
    padding-left: calc(var(--m3-row-cover) + 16px);
  }
}

.album-table-header,
.artist-table-header {
  height: 48px;
  border-bottom: 1px solid var(--schemes-outline-variant);
  background: var(--schemes-surface);
}
