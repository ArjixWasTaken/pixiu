/* Context menus as Material 3 menus; on phones, as bottom sheets. */
/* Reka UI places the menu (in a wrapper of its own) and runs it. */
.context-menu {
  @apply relative w-max z-1001;

  min-width: 200px;
  max-width: 320px;
  padding: 8px 0;
  border: 0;
  border-radius: 4px;
  background: var(--schemes-surface-container);
  color: var(--schemes-on-surface);
  box-shadow: var(--m3-elevation-2);

  &:focus,
  &:focus-visible {
    outline: none !important;
  }

  .arrow {
    @apply absolute w-[8px] aspect-square rotate-45;

    background: var(--schemes-surface-container);
  }

  li {
    @apply relative whitespace-nowrap cursor-pointer;

    /* 48px for a finger, 32px with a mouse: the same as every other menu. */
    min-height: var(--m3-menu-item-height);
    padding: 0 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--schemes-on-surface);
    font-size: calc(var(--static-label-large-size) * 1px);
    line-height: calc(var(--static-label-large-line-height) * 1px);
    letter-spacing: calc(var(--static-label-large-tracking) * 1px);
    font-weight: 500;
    outline: none;

    &:hover,
    &:focus,
    &[data-highlighted],
    &[data-state='open'] {
      background: color-mix(in srgb, var(--schemes-on-surface) 8%, transparent);
    }

    &.separator {
      @apply pointer-events-none;

      min-height: 0;
      height: 1px;
      margin: 8px 0;
      padding: 0;
      background: var(--schemes-outline-variant);
    }
  }

  &.sheet {
    width: 100%;
    max-width: none;
    max-height: min(80vh, 640px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 28px 0 16px;
    border-radius: 28px 28px 0 0;
    background: var(--schemes-surface-container-low);
    box-shadow: none;

    .sheet-handle {
      position: absolute;
      top: 12px;
      left: calc(50% - 16px);
      width: 32px;
      height: 4px;
      border-radius: 2px;
      background: var(--schemes-on-surface-variant);
      opacity: 0.4;
    }

    li {
      min-height: 56px;
      padding: 0 24px;
      gap: 16px;
      font-size: calc(var(--static-body-large-size) * 1px);
      line-height: calc(var(--static-body-large-line-height) * 1px);
      font-weight: 400;
      white-space: normal;
    }

    li.separator {
      min-height: 0;
      padding: 0;
    }

    /* A submenu opens in place, under its item. */
    .submenu.in-place {
      padding: 0 0 0 16px;
    }
  }
}
